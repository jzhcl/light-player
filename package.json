{
  "name": "light-player",
  "author": "jzhcl",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "一个支持插件扩展与主题定制的本地音乐播放器",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -b",
    "pack:win": "pnpm build && electron-builder --win --publish never && node scripts/clean-release.cjs",
    "release": "node scripts/release.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "axios": "^1.20.0",
    "electron-dl-manager": "^4.2.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "gsap": "^3.15.0",
    "lru-cache": "^11.5.3",
    "music-metadata": "^11.15.0",
    "pinyin-pro": "^3.29.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tinykeys": "^4.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "oxc-transform-react": "^0.148.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-svgr": "^5.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
